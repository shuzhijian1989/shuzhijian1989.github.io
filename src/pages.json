{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
      "^z-paging$": "z-paging/components/z-paging/z-paging.vue"
    }
  },
  "pages": [
    { "path": "pages/today/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/precision/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/lesson/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/tutor/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/precision/diagnostic", "style": { "navigationStyle": "custom" } },
    { "path": "pages/precision/result", "style": { "navigationStyle": "custom" } },
    { "path": "pages/precision/practice", "style": { "navigationStyle": "custom" } },
    { "path": "pages/lesson/player", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine/textbook", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine/wrongs", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine/report", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine/records", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine/parent", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine/paper", "style": { "navigationStyle": "custom" } }
