  "globalStyle": {
    "navigationStyle": "custom",
    "backgroundColor": "#f4f7f5"
  },
  "tabBar": {
    "color": "#8b93a7",
    "selectedColor": "#1f6f5b",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/today/index", "text": "今日学", "iconPath": "static/tab/today.png", "selectedIconPath": "static/tab/today-on.png" },
      { "pagePath": "pages/precision/index", "text": "精准学", "iconPath": "static/tab/precision.png", "selectedIconPath": "static/tab/precision-on.png" },
      { "pagePath": "pages/lesson/index", "text": "互动课", "iconPath": "static/tab/lesson.png", "selectedIconPath": "static/tab/lesson-on.png" },
      { "pagePath": "pages/tutor/index", "text": "问老师", "iconPath": "static/tab/tutor.png", "selectedIconPath": "static/tab/tutor-on.png" },
      { "pagePath": "pages/mine/index", "text": "我的", "iconPath": "static/tab/mine.png", "selectedIconPath": "static/tab/mine-on.png" }
    ]
